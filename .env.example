# Set a local development password before starting Compose. Never commit .env.
DB_PASSWORD=
DB_NAME=devjob
DB_USERNAME=devjob
DB_HOST=localhost
DB_PORT=5432
SERVER_PORT=8080
# Local HTTP only. Use true with HTTPS in deployment.
SESSION_COOKIE_SECURE=false
# Base64-encoded 32-byte key for resume, draft, and cover-letter encryption. Keep the same key for existing data.
# RESUME_ENCRYPTION_KEY=
# Server-side education-program OpenAI-compatible API key; never commit its value.
# Leave unset when AI analysis is unavailable; an empty value prevents Spring AI startup.
# OPENAI_API_KEY=
# Server-side Work24 public recruitment API key.
# WORK24_AUTH_KEY=
# Work24 국민내일배움카드 훈련과정. Reserved for future integration.
# WORK24_NAEILBAEUM_CARD_TRAINING_AUTH_KEY=
# Work24 사업주훈련 훈련과정. Reserved for future integration.
# WORK24_EMPLOYER_TRAINING_AUTH_KEY=
# Work24 국가인적자원개발 컨소시엄 훈련과정. Reserved for future integration.
# WORK24_HRD_CONSORTIUM_TRAINING_AUTH_KEY=
# Work24 일학습병행 훈련과정. Reserved for future integration.
# WORK24_WORK_STUDY_TRAINING_AUTH_KEY=
# Work24 구직자취업역량 강화프로그램. Reserved for future integration.
# WORK24_JOB_SEEKER_PROGRAM_AUTH_KEY=
# Work24 강소기업. Reserved for future integration.
# WORK24_SMALL_GIANT_COMPANY_AUTH_KEY=
# Work24 직업정보. Reserved for future integration.
# WORK24_OCCUPATION_INFO_AUTH_KEY=
# Work24 공통코드. Reserved for future integration.
# WORK24_COMMON_CODE_AUTH_KEY=
# Work24 직무정보. Reserved for future integration.
# WORK24_JOB_DUTY_INFO_AUTH_KEY=
# Work24 학과정보. Reserved for future integration.
# WORK24_MAJOR_INFO_AUTH_KEY=
# Server-side public institution recruitment API key; keep its value only in ignored .env.
# ALIO_SERVICE_KEY=
# Comma-separated existing account emails allowed to start and inspect the ALIO manual batch.
# ALIO_BATCH_ADMIN_EMAILS=
